NODE_ENV=production
PORT=3001
LOG_LEVEL=info

# PostgreSQL (Supabase or any Postgres)
DATABASE_URL=postgresql://user:password@host:5432/hypepool?sslmode=require

# CORS — set to your frontend domain in production
CORS_ORIGIN=https://yourdomain.com

# Stellar — mainnet values
STELLAR_NETWORK=mainnet
STELLAR_RPC_URL=https://soroban-rpc.mainnet.stellar.org
STELLAR_HORIZON_URL=https://horizon.stellar.org
STELLAR_NETWORK_PASSPHRASE=Public Global Stellar Network ; September 2015
FACTORY_CONTRACT_ADDRESS=C...
TOKEN_CONTRACT_ADDRESS=C...

# Oracle keypair — keep this secret, never commit
ORACLE_SECRET_KEY=S...

# YouTube Data API v3
YOUTUBE_API_KEY=AIza...

# AES-256-GCM master key for custodial wallet encryption (32 random bytes, hex-encoded)
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ENCRYPTION_MASTER_KEY=your_64_char_hex_string_here
