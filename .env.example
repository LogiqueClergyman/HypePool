NODE_ENV=production
PORT=3001
LOG_LEVEL=info

DATABASE_URL=postgresql://user:password@host:5432/hypepool?sslmode=require
CORS_ORIGIN=http://localhost:3000

# --- 1-min real testing ---
# APP_MODE=testmode
# MARKET_WINDOW_UNIT=minutes
# MARKET_TIME_WINDOWS=1

# --- Mainnet-like behavior (hours, full ladder) ---
# APP_MODE=mainnet
# MARKET_WINDOW_UNIT=hours
# MARKET_TIME_WINDOWS=12,24,48,72
# MAX_VIDEO_AGE_HOURS=72
# MARKET_MAX_TIERS=4
# MARKET_VIEW_LADDER=1000,5000,10000,25000,50000,100000,250000,500000,1000000,2500000,5000000,10000000,25000000,50000000,100000000,500000000,1000000000,2000000000,5000000000

STELLAR_NETWORK=testnet
STELLAR_RPC_URL=https://soroban-testnet.stellar.org
STELLAR_HORIZON_URL=https://horizon-testnet.stellar.org
STELLAR_NETWORK_PASSPHRASE=Test SDF Network ; September 2015
FACTORY_CONTRACT_ADDRESS=C...
TOKEN_CONTRACT_ADDRESS=C...
ORACLE_SECRET_KEY=S...
YOUTUBE_API_KEY=AIza...
ENCRYPTION_MASTER_KEY=your_64_char_hex_string_here

ENABLE_TESTNET_TOKEN_FAUCET=false
TOKEN_FAUCET_SECRET_KEY=S...
TOKEN_FAUCET_AMOUNT_RAW=100000000000

# Next.js (same root `.env`; frontend/next.config.ts loads it)
NEXT_PUBLIC_API_URL=http://localhost:3001/api
NEXT_PUBLIC_STELLAR_NETWORK=TESTNET
