{
  "manifest_version": 3,
  "name": "HypePool",
  "version": "1.0.0",
  "description": "Stake on viral content from TikTok, YouTube, and Instagram. One-click pool creation.",
  "permissions": ["activeTab", "storage"],
  "host_permissions": [
    "https://*.tiktok.com/*",
    "https://*.youtube.com/*",
    "https://*.instagram.com/*"
  ],
  "content_scripts": [
    {
      "matches": [
        "https://www.tiktok.com/*",
        "https://www.youtube.com/watch*",
        "https://www.youtube.com/shorts/*",
        "https://www.instagram.com/reel/*",
        "https://www.instagram.com/p/*"
      ],
      "js": ["content.js"],
      "css": ["content.css"],
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "HypePool"
  },
  "background": {
    "service_worker": "background.js"
  },
  "icons": {
    "16": "icon16.png",
    "48": "icon48.png",
    "128": "icon128.png"
  }
}
