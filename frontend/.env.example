# Frontend (Next.js) — copy to repo-root `.env` or `frontend/.env.local`.
# `frontend/next.config.ts` loads env from `frontend/` first, else the parent repo directory.

NEXT_PUBLIC_API_URL=http://localhost:3001/api
NEXT_PUBLIC_STELLAR_NETWORK=TESTNET

# Optional: read contract state client-side
# NEXT_PUBLIC_CONTRACT_ID=
